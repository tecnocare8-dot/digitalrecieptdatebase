// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

// 本番のNeonには旧版アプリの表が public スキーマに残っているため、
// このアプリの表は専用の app スキーマに置き、旧版の表とは混ぜない
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
  schemas   = ["app"]
}

// Googleログインした利用者。領収書の画像・内容は利用者本人のGoogleドライブに保存し、
// ここにはプラン状態と、ドライブへ書き込むための連携情報だけを持つ
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  // Proの有効期限。null=一度も購入していない、過去日時=期限切れ
  proExpiresAt       DateTime?
  // Googleのリフレッシュトークン（lib/crypto.ts で暗号化して保存）。null=ドライブ未連携
  googleRefreshToken String?
  // 領収書を保存するドライブのフォルダ（このアプリが作成したもの）
  driveFolderId      String?
  driveFolderName    String?
  createdAt          DateTime  @default(now())
  payments           Payment[]

  @@schema("app")
}

// Stripe Checkout 1回ごとの記録。stripeSessionId の一意制約で、webhook と戻り画面の確認が
// 重なっても期限延長が1回しか適用されないようにする
model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSessionId String   @unique
  amount          Int
  currency        String
  createdAt       DateTime @default(now())

  @@schema("app")
}
